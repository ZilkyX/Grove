# Set to "production" in production deployments so auth cookies get the `secure` flag.
NODE_ENV=development

PORT=5000

# Public URL of the frontend (used for CORS and Stripe redirect URLs)
CLIENT_URL=http://localhost:5173

MONGO_URI=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

STRIPE_SECRET_KEY=
